PORT=8787

# Control plane DB (kurum kaydı)
CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personel_planla_control

# CREATE DATABASE yetkisi olan bağlantı (genelde postgres veritabanına)
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Her tenant DB için şablon — {db} tenant adıyla değişir
TENANT_DATABASE_URL_TEMPLATE=postgresql://postgres:postgres@localhost:5432/{db}

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — virgülle ayrılmış origin listesi. Boş veya * ise tümüne izin verilir.
# Örn: CORS_ORIGINS=https://panel.ornek.com,http://localhost:8081
CORS_ORIGINS=*

# Rate limit (opsiyonel — varsayılanlar: genel 200/dk, auth 20/15dk)
RATE_LIMIT_GENERAL=200
RATE_LIMIT_AUTH=20

# Reverse proxy arkasındaysa hop sayısı (rate limit için doğru IP)
TRUST_PROXY=1

# Eski push uçları için (opsiyonel)
API_KEY=change-me-in-production

# Firebase Admin SDK (opsiyonel)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
